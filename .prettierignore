# Generated code: the formatter must not touch it. `buf generate` writes these
# files, and CI proves they are in sync by regenerating and diffing — a
# prettier pass would make that diff fail on every run.
packages/sdk/src/gen/

# Build output.
**/dist/
**/build/
**/.next/
**/coverage/
**/target/
apps/frontend/helm/dev-dist/

# Web assets copied into the native shells by `cap sync` (minified, and each
# is a duplicate of dist/). Git ignores them via the nested .gitignore files,
# which prettier's --ignore-path does not read.
apps/frontend/helm/ios/App/App/public/
apps/frontend/helm/android/app/src/main/assets/public/

# Generated by the package manager.
pnpm-lock.yaml
