# Backend RPC endpoint — the public RPC listener (GRPC_PORT), which the browser
# calls directly with the Connect protocol
VITE_RPC_URL=http://localhost:50051
# WebSocket (Socket.io) endpoint — backend HTTP port
VITE_WS_URL=http://localhost:3100
# REST base URL — bare origin, WITHOUT /api (the SDK appends /api itself)
VITE_API_BASE_URL=http://localhost:3100
# Public site origin — used to build absolute canonical/OG URLs for SEO.
# Set to your real domain in production, e.g. https://tropis.example.com
VITE_SITE_URL=http://localhost:5173
# Tenant this console signs in to (sent as X-Tenant-ID; the backend has no
# default tenant). Users must exist in this tenant.
VITE_TENANT_ID=dev
