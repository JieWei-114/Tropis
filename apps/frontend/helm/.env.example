# gRPC-Web endpoint (Envoy proxy — see infra/envoy/envoy.yaml)
VITE_GRPC_WEB_URL=http://localhost:8090
# WebSocket (Socket.io) endpoint — backend HTTP port
VITE_WS_URL=http://localhost:3100
# REST base URL — bare origin, WITHOUT /api (the SDK appends /api itself)
VITE_API_BASE_URL=http://localhost:3100
# Public site origin — used to build absolute canonical/OG URLs for SEO.
# Set to your real domain in production, e.g. https://tropis.example.com
VITE_SITE_URL=http://localhost:5173
