# ── Server ───────────────────────────────────────────────────────────────────
PORT=3100
GRPC_PORT=50051
# Internal gRPC tier (app.<domain>.internal.v1) — separate listener so
# exposure is port-level: 50051 goes through Envoy/ingress, 50061 is
# cluster-internal only (ClusterIP Service + NetworkPolicy in production).
GRPC_INTERNAL_PORT=50061
# gRPC server reflection (powers grpcui/grpcurl without -proto flags).
# Auto-enabled whenever NODE_ENV != production; set true to force it on in
# production. Reflection reveals the full schema — keep it OFF on the public
# listener in prod (both listeners share this gate).
GRPC_REFLECTION=false
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Use replica set mode for transactions: remove directConnection and include replicaSet.
MONGODB_URI=mongodb://localhost:27018/tropis?directConnection=true

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=logs

# ── Aerospike ─────────────────────────────────────────────────────────────────
AEROSPIKE_HOST=localhost
AEROSPIKE_PORT=3000

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-only-secret-change-in-production-32ch
JWT_EXPIRES_IN=15m

# ── Request signing (docs/api-conventions.md) ────────────────────────────────
# API keys for HMAC-signed server-to-server REST calls (X-Api-Key/X-Signature).
# JSON map of { keyId: secret }. Empty map = signed tier disabled (any signed
# request gets 401 API_KEY_UNKNOWN). May also be provided via Vault KV — it is
# merged into process.env at bootstrap. Production: one Vault KV entry per key.
# Example: API_KEYS={"svc-ingest":"a-long-random-secret-at-least-32-chars"}
API_KEYS={}

# Internal gRPC tier (app.<domain>.internal.v1) service identity. Callers send
# it as `x-service-token` metadata. Leave empty to disable the internal tier
# (internal RPCs return UNIMPLEMENTED). Production should use mTLS/SPIFFE
# instead of a shared token.
SERVICE_TOKEN=

# ── gRPC ──────────────────────────────────────────────────────────────────────

# ── Pulsar ────────────────────────────────────────────────────────────────────
PULSAR_SERVICE_URL=pulsar://localhost:6650

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=nestjs-app
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ── PostgreSQL + pgvector ─────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tropis
POSTGRES_PASSWORD=tropis_dev_password
POSTGRES_DB=tropis
POSTGRES_SSL=false
TYPEORM_SYNC=true          # set false in staging/prod — use migrations instead

# ── Elasticsearch ─────────────────────────────────────────────────────────────
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ── OPA (policy engine) ───────────────────────────────────────────────────────
OPA_URL=http://localhost:8181

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9900
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=app-uploads

# ── SMTP / MailHog ────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@tropis.local
SMTP_USER=
SMTP_PASS=

# ── Messaging ─────────────────────────────────────────────────────────────────
# Broker behind MessageBrokerPort (src/infrastructure/messaging). Valid: pulsar
# (kafka is a future adapter — see docs/tech-decisions.md)
MESSAGE_BROKER=pulsar

# ── Temporal ──────────────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=notifications

# ── SMS ───────────────────────────────────────────────────────────────────────
SMS_PROVIDER=stub

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── HashiCorp Vault ───────────────────────────────────────────────────────────
# Optional — set to pull secrets from Vault instead of .env at startup.
# Leave blank to use plain .env values (default for quick local runs).
# Run: docker compose up -d vault vault-init
# Then copy the VAULT_TOKEN printed by vault-init into this file.
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_SECRET_PATH=secret/data/tropis

# ── OAuth2 / SSO ───────────────────────────────────────────────────────────────
# Leave blank to disable the provider — the /auth/google and /auth/github routes
# will return a 500 if the credentials are missing.
#
# Google: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3100/api/auth/google/callback

# GitHub: https://github.com/settings/applications/new
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3100/api/auth/github/callback

# ── Multi-tenancy ──────────────────────────────────────────────────────────────
# Tenants are identified by tenantId in the JWT and X-Tenant-ID header.
# For single-tenant / self-hosted deployments this defaults to 'default'.
DEFAULT_TENANT=default
