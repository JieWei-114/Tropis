# ── Server ───────────────────────────────────────────────────────────────────
PORT=3100
RPC_PUBLIC_PORT=50051
# Internal RPC tier (tropis.<domain>.internal.v1) — separate listener so
# exposure is port-level: 50051 is served through the ingress, 50061 is
# cluster-internal only (ClusterIP Service + NetworkPolicy in production).
RPC_INTERNAL_PORT=50061
# Ops listener every role runs (/livez, /readyz, /metrics); cluster-internal.
OPS_PORT=9464
# gRPC server reflection (powers grpcui/grpcurl without -proto flags).
# Auto-enabled whenever NODE_ENV != production; set true to force it on in
# production. Reflection reveals the full schema — keep it OFF on the public
# listener in prod (both listeners share this gate).
GRPC_REFLECTION=false
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── MongoDB ───────────────────────────────────────────────────────────────────
# The server runs as replica set rs0, so transactions work. Host clients keep
# directConnection=true because the member advertises an in-container address.
MONGODB_URI=mongodb://localhost:27018/tropis?directConnection=true

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Keyspace ──────────────────────────────────────────────────────────────────
# Prefix of every cache/kv/lock/ratelimit/dedup key: {app}:{env}:... so apps
# and environments sharing one server never collide. KEYSPACE_ENV defaults to
# NODE_ENV. Lowercase kebab-case.
KEYSPACE_APP=tropis
KEYSPACE_ENV=development

# ── Capability adapters ───────────────────────────────────────────────────────
# Which adapter backs each capability port (src/infrastructure/<capability>).
# `disabled` makes every call throw CapabilityDisabledError.
CACHE_ADAPTER=redis             # redis | disabled
KV_ADAPTER=redis                # redis | aerospike | disabled
LOCK_ADAPTER=redis              # redis | disabled
RATE_LIMIT_ADAPTER=redis        # redis | disabled
DEDUP_ADAPTER=redis             # redis | disabled
GRAPH_ADAPTER=disabled          # neo4j | disabled
REALTIME_ADAPTER=redis          # redis | local (local: only sockets of the publishing process)
VECTOR_ADAPTER=pgvector         # pgvector | disabled
SEARCH_ADAPTER=elasticsearch    # elasticsearch | disabled
OLAP_ADAPTER=clickhouse         # clickhouse | disabled
OBJECTS_ADAPTER=minio           # minio | disabled
WORKFLOW_ADAPTER=temporal       # temporal | disabled
SECRETS_ADAPTER=vault           # vault | env (env: encrypt() returns null, callers redact)
MAIL_ADAPTER=smtp               # smtp | log (log: messages are logged, not sent)
SIGNING_ADAPTER=inprocess       # inprocess | native (gRPC to services/rust/signing)
# Native signing service (SIGNING_ADAPTER=native); it needs the same API_KEYS.
SIGNING_SERVICE_URL=http://localhost:50052

# ── Neo4j (graph, compose profile `graph`) ────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tropis_dev_password

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=logs

# ── Stream engine ─────────────────────────────────────────────────────────────
# The one writer of analytics events to OLAP: node (AnalyticsProcessor) or
# flink (services/flink; the Node processor then does not subscribe).
STREAM_ENGINE=node

# ── Aerospike ─────────────────────────────────────────────────────────────────
AEROSPIKE_HOSTS=localhost:3000

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-only-secret-change-in-production-32ch
JWT_EXPIRES_IN=15m

# ── Request signing (docs/api-conventions.md) ────────────────────────────────
# API keys for HMAC-signed server-to-server REST calls (X-Api-Key/X-Signature).
# JSON map of { keyId: { secret, tenantId } }: each key acts for its own tenant
# only, and a signed request whose X-Tenant-ID names another tenant is refused
# (TENANT_MISMATCH). Empty map = signed tier disabled (401 API_KEY_UNKNOWN).
# May also come from Vault KV, merged before config validation.
# Example: API_KEYS={"svc-ingest":{"secret":"a-long-random-secret-at-least-32-chars","tenantId":"acme"}}
# The value below is a LOCAL DEVELOPMENT key for the dev tenant, so
# `POST /api/v1/track/secure` works straight after `make install`.
API_KEYS={"svc-ingest":{"secret":"dev-only-signing-secret-change-me-32chars","tenantId":"dev"}}

# Rate limiting (per source IP). RATE_LIMIT_AUTH covers the credential
# endpoints (login/refresh/OAuth callbacks) and is intentionally strict.
# `make test-e2e` raises it, because the browser suite drives many real
# sign-ins from a single IP.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_AUTH=10

# Self sign-up (UserService/Create without a token) per client address across
# tenants and per tenant, in one window. `make test-e2e` raises both.
SIGNUP_RATE_LIMIT_IP=10
SIGNUP_RATE_LIMIT_TENANT=200
SIGNUP_RATE_LIMIT_WINDOW_S=3600

# Internal gRPC tier (tropis.<domain>.internal.v1) service identity. Callers send
# it as `x-service-token` metadata. Leave empty to disable the internal tier
# (internal RPCs return UNIMPLEMENTED). Production should use mTLS/SPIFFE
# instead of a shared token.
SERVICE_TOKEN=

# ── gRPC ──────────────────────────────────────────────────────────────────────

# ── Pulsar ────────────────────────────────────────────────────────────────────
PULSAR_SERVICE_URL=pulsar://localhost:6650

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=tropis-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
SERVICE_VERSION=

# ── PostgreSQL + pgvector ─────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tropis
POSTGRES_PASSWORD=tropis_dev_password
POSTGRES_DB=tropis
POSTGRES_SSL=false
# PEM of the CA that signed the server certificate (with POSTGRES_SSL=true);
# the certificate is always verified, against the system roots when unset.
POSTGRES_SSL_CA=
# Connection retries at boot: attempts and delay between them (ms).
POSTGRES_RETRY_ATTEMPTS=30
POSTGRES_RETRY_DELAY=3000
# node-pg-migrate (make migrate) connects with this URL, not the POSTGRES_* values.
DATABASE_URL=postgres://tropis:tropis_dev_password@localhost:5432/tropis
TYPEORM_SYNC=true          # set false in staging/prod — use migrations instead

# ── Elasticsearch ─────────────────────────────────────────────────────────────
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ── OPA (policy engine) ───────────────────────────────────────────────────────
OPA_URL=http://localhost:8181

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9900
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=app-uploads

# ── SMTP (Mailpit locally) ────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@tropis.local
SMTP_USER=
SMTP_PASS=

# ── Messaging ─────────────────────────────────────────────────────────────────
# Broker behind MessagingPort (src/infrastructure/messaging).
# Valid: pulsar | kafka | disabled
MESSAGING_ADAPTER=pulsar
# Kafka (used when MESSAGING_ADAPTER=kafka): comma-separated host:port list
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=tropis-backend
# A failed message is redelivered with a doubling delay (base up to the
# ceiling, at most 50000) and dead-lettered after the last redelivery
MESSAGING_MAX_REDELIVERIES=10
MESSAGING_REDELIVERY_DELAY_MS=1000
MESSAGING_MAX_REDELIVERY_DELAY_MS=30000
# Days a dispatched or skipped outbox row is kept before MongoDB deletes it
OUTBOX_RETENTION_DAYS=7

# ── Temporal ──────────────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Delay before the onboarding workflow fires its follow-up step (at most 30 days)
ONBOARDING_FOLLOWUP_DELAY_MS=30000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# json: one JSON record per line in development too (production always is)
LOG_FORMAT=

# ── HashiCorp Vault ───────────────────────────────────────────────────────────
# Optional — set to pull secrets from Vault instead of .env at startup.
# Leave blank to use plain .env values (default for quick local runs).
# Run: docker compose up -d vault vault-init
# Then copy the VAULT_TOKEN printed by vault-init into this file.
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
# AppRole login instead of a token (both set wins over VAULT_TOKEN)
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_SECRET_PATH=secret/data/tropis

# ── OAuth2 / SSO ───────────────────────────────────────────────────────────────
# Leave blank to disable the provider — the /auth/google and /auth/github routes
# answer 501 (OAUTH_NOT_CONFIGURED) if the credentials are missing.
#
# Google: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3100/api/auth/google/callback

# GitHub: https://github.com/settings/applications/new
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3100/api/auth/github/callback

# ── Multi-tenancy ──────────────────────────────────────────────────────────────
# There is no default tenant: a verified token names it, otherwise the caller
# sends X-Tenant-ID (docs/architecture.md, Multi-tenancy). A tenant must be
# registered (make tenant-create) before anyone can sign up or log in to it;
# `make seed` registers `dev` with self sign-up on.
# Tenant that Google/GitHub sign-ins belong to; unset, OAuth callbacks answer
# TENANT_REQUIRED. New OAuth accounts need that tenant's self sign-up on.
OAUTH_TENANT_ID=
