{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tropis",
  "version": "0.1.0",
  "identifier": "dev.tropis.app",
  "build": {
    "frontendDist": "../../../frontend/helm/dist",
    "beforeBuildCommand": "pnpm --filter @tropis/helm build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @tropis/helm dev"
  },
  "app": {
    "windows": [
      {
        "title": "Tropis",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
