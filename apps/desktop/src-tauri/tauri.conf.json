{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tropis",
  "version": "0.1.0",
  "identifier": "dev.tropis.app",
  "build": {
    "frontendDist": "../../../apps/frontend/helm/dist",
    "beforeBuildCommand": "pnpm --filter @tropis/helm build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @tropis/helm dev"
  },
  "app": {
    "windows": [
      {
        "title": "Tropis",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:3100 http://localhost:50051 ws://localhost:3100",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["tropis"]
      }
    }
  }
}
